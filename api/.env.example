DATABASE_URL=postgresql://wizydoc:wizydoc@localhost:5432/wizydoc
JWT_SECRET=change-this-to-a-secure-random-string
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Huso en el que operan las clínicas: convierte las horas de reloj de la agenda
# a instantes. Provisional hasta que cada Clinic tenga el suyo.
CLINIC_TIME_ZONE=America/Lima

# AWS SES (local: AWS_PROFILE from `aws configure sso`; App Runner: IAM role)
AWS_PROFILE=wizydoc
AWS_REGION=us-east-1
EMAIL_FROM=test@test.com
BETTER_AUTH_SECRET=secret